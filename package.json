{
  "name": "@saffan/devtools-js",
  "version": "2.0.0",
  "description": "Tiny zero-dependency powerful utilities for Node.js developers - array, math, date, url, cli, system, fs, structures, stream, and crypto utilities",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./array": {
      "import": "./dist/utils/array.js",
      "require": "./dist/utils/array.cjs",
      "types": "./dist/utils/array.d.ts"
    },
    "./math": {
      "import": "./dist/utils/math.js",
      "require": "./dist/utils/math.cjs",
      "types": "./dist/utils/math.d.ts"
    },
    "./date": {
      "import": "./dist/utils/date.js",
      "require": "./dist/utils/date.cjs",
      "types": "./dist/utils/date.d.ts"
    },
    "./url": {
      "import": "./dist/utils/url.js",
      "require": "./dist/utils/url.cjs",
      "types": "./dist/utils/url.d.ts"
    },
    "./cli": {
      "import": "./dist/utils/cli.js",
      "require": "./dist/utils/cli.cjs",
      "types": "./dist/utils/cli.d.ts"
    },
    "./system": {
      "import": "./dist/utils/system.js",
      "require": "./dist/utils/system.cjs",
      "types": "./dist/utils/system.d.ts"
    },
    "./fs": {
      "import": "./dist/utils/fs.js",
      "require": "./dist/utils/fs.cjs",
      "types": "./dist/utils/fs.d.ts"
    },
    "./structures": {
      "import": "./dist/utils/structures.js",
      "require": "./dist/utils/structures.cjs",
      "types": "./dist/utils/structures.d.ts"
    },
    "./stream": {
      "import": "./dist/utils/stream.js",
      "require": "./dist/utils/stream.cjs",
      "types": "./dist/utils/stream.d.ts"
    },
    "./crypto": {
      "import": "./dist/utils/crypto.js",
      "require": "./dist/utils/crypto.cjs",
      "types": "./dist/utils/crypto.d.ts"
    },
    "./utils": {
      "import": "./dist/utils/index.js",
      "require": "./dist/utils/index.cjs",
      "types": "./dist/utils/index.d.ts"
    }
  },
  "bin": {
    "devtools-js": "./cli.js"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "cli.js"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "prepublishOnly": "npm run test && npm run build",
    "preview": "npm pack --dry-run"
  },
  "keywords": [
    "utils",
    "helpers",
    "node",
    "developer-tools",
    "devtools",
    "data-structures",
    "cryptography",
    "streams",
    "file-system",
    "cli",
    "url",
    "math",
    "date",
    "typescript"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.10",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.6.0",
    "vite-tsconfig-paths": "^6.0.5"
  },
  "dependencies": {
    "@types/chalk": "^0.4.31",
    "chalk": "^5.6.2",
    "commander": "^14.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
