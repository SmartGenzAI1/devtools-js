{
  "name": "devtools-js",
  "version": "1.0.0",
  "description": "Tiny zero-dependency powerful utilities for Node.js developers",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./cli": "./cli.js"
  },
  "bin": {
    "devtools-js": "./cli.js"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "cli.js"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w"
  },
  "keywords": [
    "utils",
    "helpers",
    "node",
    "developer-tools",
    "devtools"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.0.10",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@types/chalk": "^0.4.31",
    "chalk": "^5.6.2",
    "commander": "^14.0.2"
  }
}
